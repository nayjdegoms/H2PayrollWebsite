@page "/partners"

<PageTitle>Partners | H2 Payroll</PageTitle>

<section class="page-hero">
  <div class="page-hero-overlay">
    <div class="container">
      <h2 class="section-kicker"><span>OUR</span>PARTNERS</h2>
    </div>
  </div>
</section>

<section class="section">
  <div class="container solution-detail-grid">
    <article class="partner-card-grid" style="--partner-index: 0">
      <img src="images/PNB LOGO.png"
           alt="Philippine National Bank"
           class="partner-card-pic" />
      <a href="https://www.pnb.com.ph/">www.pnb.com</a>
    </article>

    <article class="partner-card-grid" style="--partner-index: 1">
      <img src="images/UnionBank Logo.png"
           alt="Union Bank"
           class="partner-card-pic" />

      <a href="https://unionbankph.com/">www.unionbankph.com</a>
    </article>

    @* <article class="partner-card-grid" style="--partner-index: 2">
      <img src="images/ROBINSONS BANK LOGO.png"
           alt="Robinsons Bank"
           class="partner-card-pic" />

      <a href="https://www.robinsonsbank.com.ph/">www.robinsonsbank.com</a>
    </article> *@
  </div>
</section>

<section class="price-band" id="contact">
  <div class="container price-inner">

    <div>
      <span class="section-kicker light-kicker">LET'S TALK</span>

      <h2>
        Make payroll simpler<br />
        for your business.
      </h2>

      <p>Tell us about your team and what you need.</p>
    </div>

    <div class="price-box">
      <h3>Let's connect</h3>

      <p>We'd be happy to learn about your requirements.</p>

      <br />
      <div class="contact-list">
        <a href="mailto:HR@h2software.net">HR@h2software.net</a>
        <a href="mailto:sales@h2software.net">sales@h2software.net</a>
      </div>
    </div>

  </div>
</section>