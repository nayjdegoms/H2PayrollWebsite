@page "/"
@using H2PayrollWebsite.Components.Layout

<PageTitle>H2 Payroll | Cloud Payroll Software</PageTitle>

<section class="hero">
  <div class="hero-overlay">
    <div class="hero-glow glow-one"></div>
    <div class="hero-glow glow-two"></div>

    <div class="container hero-grid">
      <div class="hero-copy">
        @* <div class="eyebrow">
          <span class="eyebrow-dot"></span>
          MADE FOR FILIPINO BUSINESSES
        </div> *@

        <div class="hero-logo">
          <img src="images/H2-Payroll-Logo.png"
               alt="H2 Payroll"
               class="hero-logo-pic" />
        </div>

        <h2>
          A cloud payroll software built by Filipinos
          <span>for Filipino companies.</span>
        </h2>

        <p class="hero-lead">
          Payroll, timekeeping, and employee services in one reliable
          platform—built around the way businesses work in the Philippines.
        </p>

        <div class="hero-proof">
          @* <div class="proof-mark"><span class="bi bi-check"></span></div> *@
          <p>
            <strong>ALL-IN <span>₱75.<small>00*</small></span> per employee/month</strong><br />
            <span>* Minimum of 100 employees</span>
          </p>
        </div>

        <div class="hero-actions">
          <a class="button button-primary" href="/#contact">
            Talk to our team <span><i class="bi bi-arrow-down"></i></span>
          </a>

          <a class="button button-ghost" href="/our-solutions">
            Explore our solutions <span><i class="bi bi-arrow-up-right"></i></span>
          </a>
        </div>
      </div>

      <div class="hero-visual">
        <img src="images/laptop.png"
             alt="H2 Payroll"
             class="hero-visual-pic" />
      </div>
    </div>

    <div class="container hero-bottom">
      <span>ONE CONNECTED PLATFORM</span>

      <div class="hero-tags">
        <span>Payroll</span>
        <span>Timekeeping</span>
        <span>Employee Self Service</span>
        <span>Employee 201</span>
      </div>
    </div>
  </div>
</section>

