@page "/"
@using System.ComponentModel.DataAnnotations
<PageTitle>H2 Payroll | Cloud Payroll Software</PageTitle>
<section class="hero">
    <div class="hero-glow glow-one"></div><div class="hero-glow glow-two"></div>
    <div class="container hero-grid">
        <div class="hero-copy">
            <div class="eyebrow"><span class="eyebrow-dot"></span> MADE FOR FILIPINO BUSINESSES</div>
            <h1>A cloud payroll software built by Filipinos <span>for Filipino companies.</span></h1>
            <p class="hero-lead">Payroll, timekeeping, and employee services in one reliable platform—built around the way businesses work in the Philippines.</p>
            <div class="hero-actions"><a class="button button-primary" href="/contact-us">Talk to our team <span>↗</span></a><a class="button button-ghost" href="/our-solutions">Explore our solutions <span>↓</span></a></div>
            <div class="hero-proof"><div class="proof-mark">✓</div><p><strong>Designed for local compliance</strong><br/><span>Built for Philippine payroll requirements</span></p></div>
        </div>
        <div class="hero-visual">
            <div class="visual-orbit orbit-a"></div><div class="visual-orbit orbit-b"></div>
            <div class="payroll-window">
                <div class="window-top"><div class="window-dots"><i></i><i></i><i></i></div><span>H2 PAYROLL <b>● LIVE</b></span><div class="avatar">HR</div></div>
                <div class="dashboard-body"><aside class="dash-side"><div class="side-logo">H₂</div><div class="side-icon active">▦</div><div class="side-icon">◷</div><div class="side-icon">♙</div><div class="side-icon">▤</div><div class="side-icon">⚙</div></aside>
                    <div class="dash-content"><div class="dash-heading"><div><small>OVERVIEW</small><h3>Payroll dashboard</h3></div><div class="period">This month⌄</div></div>
                        <div class="metric-row"><div class="metric"><span>Total employees</span><strong>248</strong><small class="positive">↗ Active workforce</small></div><div class="metric"><span>Total payroll</span><strong>₱2.48M</strong><small>Current pay period</small></div></div>
                        <div class="chart-card"><div class="chart-title"><b>Payroll summary</b><span>Last 6 months</span></div><div class="chart"><div class="chart-y"><i>3.0M</i><i>2.0M</i><i>1.0M</i><i>0</i></div><div class="chart-bars"><div><i style="height:42%"></i><i style="height:56%"></i></div><div><i style="height:52%"></i><i style="height:64%"></i></div><div><i style="height:47%"></i><i style="height:70%"></i></div><div><i style="height:62%"></i><i style="height:75%"></i></div><div><i style="height:56%"></i><i style="height:82%"></i></div><div><i style="height:68%"></i><i style="height:91%"></i></div></div></div><div class="chart-months"><span>May</span><span>Jun</span><span>Jul</span><span>Aug</span><span>Sep</span><span>Oct</span></div></div>
                        <div class="dash-bottom"><div class="mini-card"><span>Payroll status</span><div class="status-line"><i></i><b>Ready to process</b></div></div><div class="mini-card"><span>Compliance checklist</span><div class="check-line">✓ <b>Government reports</b></div></div></div>
                    </div>
                </div>
            </div>
            <div class="float-card float-people"><div class="float-icon">♙</div><div><b>Employee records</b><small>All in one place</small></div><span class="float-check">✓</span></div>
            <div class="float-card float-pay"><div class="float-icon purple">₱</div><div><b>Payroll processed</b><small>Accurate. On time.</small></div><span class="float-check">✓</span></div>
        </div>
    </div>
    <div class="container hero-bottom"><span>ONE CONNECTED PLATFORM</span><div class="hero-tags"><span>Payroll</span><span>Timekeeping</span><span>Employee Self Service</span><span>Employee 201</span></div></div>
</section>
<section class="intro section" id="solutions"><div class="container"><div class="section-heading"><span class="section-kicker">OUR SOLUTIONS</span><h2>Everything you need to manage<br/><span>people and payroll.</span></h2><p>Less manual work. More confidence in every pay run. H2 Payroll brings your essential HR and payroll processes together.</p></div>
    <div class="solution-grid">
        <article class="solution-card"><div class="solution-icon icon-purple">▤</div><span class="card-number">01</span><h3>Payroll</h3><p>Streamline payroll calculations, deductions, and reporting with tools designed for Philippine companies.</p><a href="/our-solutions">Explore payroll <span>↗</span></a></article>
        <article class="solution-card"><div class="solution-icon icon-blue">◷</div><span class="card-number">02</span><h3>Timekeeping</h3><p>Connect schedules, attendance, overtime, and leave records for a smoother payroll process.</p><a href="/our-solutions">Explore timekeeping <span>↗</span></a></article>
        <article class="solution-card"><div class="solution-icon icon-orange">♙</div><span class="card-number">03</span><h3>Employee Self Service</h3><p>Give employees convenient access to payslips, leave balances, and HR requests.</p><a href="/our-solutions">Explore ESS <span>↗</span></a></article>
        <article class="solution-card"><div class="solution-icon icon-green">▣</div><span class="card-number">04</span><h3>Employee 201</h3><p>Keep employee profiles, employment information, and payroll records organized.</p><a href="/our-solutions">Explore Employee 201 <span>↗</span></a></article>
    </div>
</div></section>
<section class="compliance section" id="cloud-payroll"><div class="container compliance-grid"><div class="compliance-art"><div class="compliance-ring ring-1"></div><div class="compliance-ring ring-2"></div><div class="compliance-card"><div class="compliance-card-head"><span>H₂</span><div><b>Compliance center</b><small>Philippine payroll</small></div><i>✓</i></div><div class="compliance-item"><span class="mini-badge">BIR</span><div><b>Tax reporting</b><small>Withholding tax &amp; annualization</small></div><em>Ready</em></div><div class="compliance-item"><span class="mini-badge">SSS</span><div><b>Government contributions</b><small>SSS, PhilHealth &amp; Pag-IBIG</small></div><em>Ready</em></div><div class="compliance-item"><span class="mini-badge">DOLE</span><div><b>Payroll rules</b><small>Holiday pay and overtime</small></div><em>Ready</em></div></div></div><div class="compliance-copy"><span class="section-kicker">BUILT FOR THE PHILIPPINES</span><h2>Local payroll needs.<br/><span>One smarter solution.</span></h2><p>Support your payroll process with functionality designed around Philippine employment practices and statutory reporting requirements.</p><ul><li><span>✓</span> Government reporting for BIR, SSS, PhilHealth, and Pag-IBIG</li><li><span>✓</span> Support for local payroll rules and overtime rates</li><li><span>✓</span> Reports and files to help simplify compliance</li><li><span>✓</span> Payroll and timekeeping in a connected workflow</li></ul><a class="text-link" href="/our-solutions">See all solution features <span>↗</span></a></div></div></section>
<section class="price-band"><div class="container price-inner"><div><span class="section-kicker light-kicker">STRAIGHTFORWARD PRICING</span><h2>All-in payroll software<br/>for your business.</h2><p>One platform for your core payroll and employee processes.</p></div><div class="price-box"><span>ALL-IN</span><div><sup>₱</sup><strong>75</strong><small>.00*</small></div><p>per employee / month</p><small>* Minimum of 100 employees</small><a class="button button-white" href="/contact-us">Get in touch <span>↗</span></a></div></div></section>
<section class="trust section" id="clients"><div class="container trust-inner"><div><span class="section-kicker">YOUR BUSINESS, SUPPORTED</span><h2>Technology made for<br/><span>local businesses.</span></h2></div><div class="trust-copy"><p>H2 Software Consulting Services, Inc. is a Filipino IT company delivering software and technology services shaped around the needs of businesses in the Philippines.</p><a class="text-link" href="/about-us">Get to know H2 Software <span>↗</span></a></div></div><div class="container trust-strip"><div><strong>01</strong><span>Payroll built for local requirements</span></div><div><strong>02</strong><span>Connected employee processes</span></div><div><strong>03</strong><span>Support from a Filipino team</span></div></div></section>
<section class="contact section" id="contact"><div class="container contact-grid"><div class="contact-copy"><span class="section-kicker">LET'S TALK</span><h2>Ready to simplify<br/><span>your payroll?</span></h2><p>Tell us a little about your business. Our team can help you find the right H2 Payroll solution.</p><div class="contact-detail"><div class="contact-detail-icon">⌖</div><div><b>Visit our office</b><p>3F Ardan Building, #2 Meralco Avenue,<br/>Ortigas Center, Pasig City</p></div></div><div class="contact-detail"><div class="contact-detail-icon">✉</div><div><b>Email our team</b><p><a href="mailto:HR@h2software.net">HR@h2software.net</a><br/><a href="mailto:sales@h2software.net">sales@h2software.net</a></p></div></div></div>
    <div class="contact-form-card"><h3>Contact Us</h3><p>We'll get back to you as soon as we can.</p>
        @if (submitted) { <div class="success-panel"><div class="success-icon">✓</div><h4>Thanks for reaching out!</h4><p>Your message has been prepared. In this demo, it has not been sent to H2 Payroll.</p><button class="button button-primary" @onclick="ResetForm">Send another message</button></div> }
        else { <EditForm Model="contact" OnValidSubmit="SubmitForm"><DataAnnotationsValidator/><div class="form-row"><div class="field"><label>First Name</label><InputText @bind-Value="contact.FirstName" placeholder="e.g. Kat"/><ValidationMessage For="() => contact.FirstName" /></div><div class="field"><label>Last Name</label><InputText @bind-Value="contact.LastName" placeholder="e.g. Santos"/><ValidationMessage For="() => contact.LastName" /></div></div><div class="field"><label>Email</label><InputText type="email" @bind-Value="contact.Email" placeholder="name@company.com"/><ValidationMessage For="() => contact.Email" /></div><div class="field"><label>Phone</label><InputText @bind-Value="contact.Phone" placeholder="e.g. 0917 123 4567"/></div><div class="field"><label>Company</label><InputText @bind-Value="contact.Company" placeholder="Your company name"/><ValidationMessage For="() => contact.Company" /></div><div class="field"><label>How can we help? <span>(optional)</span></label><InputTextArea @bind-Value="contact.Message" placeholder="Tell us what you're looking for..." rows="3"/></div><button class="button button-primary submit-button" type="submit">Submit enquiry <span>↗</span></button><small class="form-note">Your information will be used to respond to your enquiry.</small></EditForm> }
    </div></div></section>
@code {
    private ContactModel contact = new();
    private bool submitted;
    private void SubmitForm() => submitted = true;
    private void ResetForm() { contact = new(); submitted = false; }
    private sealed class ContactModel {
        [Required, StringLength(80)] public string FirstName { get; set; } = "";
        [Required, StringLength(80)] public string LastName { get; set; } = "";
        [Required, EmailAddress] public string Email { get; set; } = "";
        public string Phone { get; set; } = "";
        [Required, StringLength(150)] public string Company { get; set; } = "";
        public string Message { get; set; } = "";
    }
}
