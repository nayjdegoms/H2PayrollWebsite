
@page "/payroll-outsourcing"

<PageTitle>Payroll Outsourcing | H2 Payroll</PageTitle>

<section class="page-hero">
    <div class="page-hero-overlay">
        <div class="container">
            <h2 class="section-kicker"><span>PAYROLL</span> OUTSOURCING</h2>
        </div>
    </div>
</section>

<section class="section">
    <div class="container hero-grid">
        <div class="hero-list-pic">
            @* <img src="images/1.jpg"
             alt="H2 Payroll"
             class="hero-visual-pic" /> *@
        </div>
        <div class="hero-list-grid">
            <article class="payroll-card-grid" style="--payroll-index: 0">
                <h2><i class="bi bi-check-circle-fill"></i>Simpler Payroll</h2>
                <p>
                    We help you overcome the complexities and risks associated with sourcing, 
                    managing and delivering payroll services.
                </p>
            </article>

            <article class="payroll-card-grid" style="--payroll-index: 1">
                <h2><i class="bi bi-check-circle-fill"></i>Increased Accuracy</h2>
                <p>
                    We standardise your payroll processes and achieve a best-in-class model 
                    with the help of H2 Payroll Software.
                </p>
            </article>

            <article class="payroll-card-grid" style="--payroll-index: 2">
                <h2><i class="bi bi-check-circle-fill"></i>Confidentiality</h2>
                <p>
                    We help you keep the confidentiality of your payroll information.
                </p>
            </article>

            <article class="payroll-card-grid" style="--payroll-index: 3">
                <h2><i class="bi bi-check-circle-fill"></i>Focus on Core Business Activities</h2>
                <p>
                    We let you focus on your primary business task while we handle the payroll 
                    processes for you.
                </p>
            </article>
        </div>
    </div>
</section>

<section class="price-band" id="contact">
    <div class="container">
        <div class="price-inner">
            <div>
                <span class="section-kicker light-kicker">
                    LET'S TALK
                </span>

                <h2>
                    Make payroll simpler
                    <br />
                    for your business.
                </h2>

                <p>
                    Tell us about your team and what you need.
                </p>
            </div>

            <div class="price-box-section">
                <div class="price-box">
                    <h3>Let's connect</h3>

                    <p>
                        We'd be happy to learn about your requirements.
                    </p>
                    <br />
                    <div class="contact-list">
                        <a href="mailto:HR@h2software.net">HR@h2software.net</a>
                        <a href="mailto:sales@h2software.net">sales@h2software.net</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>