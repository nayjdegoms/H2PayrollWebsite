@inherits LayoutComponentBase
@inject NavigationManager Navigation

<header class="site-header">
    <div class="container nav-wrap">
        <a class="brand" href="/" aria-label="H2 Payroll home">
            <img src="images/H2-Payroll-Logo.png"
                 alt="H2 Payroll" />
        </a>

        <nav class="desktop-nav">
            <NavLink class="nav-link" href="/our-solutions">Our Solutions</NavLink>
            <NavLink class="nav-link" href="/cloud-payroll">Cloud Payroll</NavLink>
            <NavLink class="nav-link" href="/payroll-outsourcing">Payroll Outsourcing</NavLink>
            <NavLink class="nav-link" href="/clients">Clients</NavLink>
            <NavLink class="nav-link" href="/partners">Partners</NavLink>
            <NavLink class="nav-link" href="/about-us">About Us</NavLink>
        </nav>

        <a class="nav-cta" href="@ContactUrl">
            Contact Us
        </a>

        <details class="mobile-menu">
            <summary aria-label="Open navigation"><i class="bi bi-list"></i></summary>

            <div class="mobile-links">
                <a href="/our-solutions">Our Solutions</a>
                <a href="/cloud-payroll">Cloud Payroll</a>
                <a href="/payroll-outsourcing">Payroll Outsourcing</a>
                <a href="/clients">Clients</a>
                <a href="/partners">Partners</a>
                <a href="/about-us">About Us</a>
                <a href="@ContactUrl">Contact Us</a>
            </div>
        </details>
    </div>
</header>

<main>
    @Body
</main>

<footer class="footer">
    <div class="container footer-grid">
        <div>
            <img class="footer-logo"
                 src="images/H2-Payroll-Logo.png"
                 alt="H2 Payroll" />

            <p>A cloud payroll software built by Filipinos for Filipino companies.</p>
        </div>

        <div>
            <h4>Explore</h4>
            <a href="/our-solutions">Our Solutions</a>
            <a href="/cloud-payroll">Cloud Payroll</a>
            <a href="/payroll-outsourcing">Payroll Outsourcing</a>
            <a href="/clients">Clients</a>
            <a href="/partners">Partners</a>
            <a href="/about-us">About Us</a>
        </div>

        <div>
            <h4>Contact Us</h4>
            <p>
                3F Ardan Building, #2 Meralco Avenue,<br />
                Ortigas Center, Pasig City
            </p>
            <a href="mailto:HR@h2software.net">HR@h2software.net</a>
            <a href="mailto:sales@h2software.net">sales@h2software.net</a>
        </div>
    </div>

    <div class="container footer-bottom">
        <span>© @DateTime.Now.Year H2 Software Consulting Services, Inc.</span>
        <span>Payroll made simpler.</span>
    </div>
</footer>

@code {
    private string ContactUrl
    {
        get
        {
            var currentPath = new Uri(Navigation.Uri).AbsolutePath;

            // If you're on the home page, use /#contact
            if (currentPath == "/")
                return "/#contact";

            // Otherwise, use the current page path
            return $"{currentPath.TrimEnd('/')}#contact";
        }
    }
}